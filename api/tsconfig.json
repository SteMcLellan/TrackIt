{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "functions",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "@azure/functions"]
  },
  "include": ["src/**/*.ts"]
}
